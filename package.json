{
  "name": "class-resources-monorepo",
  "private": true,
  "packageManager": "npm@11.21.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "npm run db:generate --workspace=@repo/api",
    "db:push": "npm run db:push --workspace=@repo/api",
    "db:seed": "npm run db:seed --workspace=@repo/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
